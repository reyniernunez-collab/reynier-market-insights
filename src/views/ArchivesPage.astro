---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getLocalizedPosts } from "@/utils/localizedPosts";
import { getPostsByGroupCondition } from "@/utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import config from "@/config";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const filteredPosts = getLocalizedPosts(await getCollection("posts"), locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout
  title={`${t.pages.archivesTitle} | ${config.site.title}`}
  description={t.pages.archivesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getPostsByGroupCondition(filteredPosts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg capitalize sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          new Date(b.data.pubDatetime).getTime() -
                          new Date(a.data.pubDatetime).getTime()
                      )
                      .map(data => (
                        <Card {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>

  <Footer />
</Layout>
