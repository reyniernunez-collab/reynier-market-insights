---
import { getCollection } from "astro:content";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getLocalizedPosts } from "@/utils/localizedPosts";
import { useTranslations } from "@/i18n";
import { localizedUrl, toLocale } from "@/i18n/locales";
import config from "@/config";

const { socials, posts: postsConfig } = config;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const posts = getLocalizedPosts(await getCollection("posts"), locale);
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.filter(({ data }) => !data.featured);
const instagram = socials.find(s => s.name === "instagram");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={localizedUrl(locale, "")}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {t.home.heroTitle}
      </h1>
      <a
        target="_blank"
        href={localizedUrl(locale, "rss.xml")}
        class="ms-2 inline-block align-middle"
        aria-label="RSS"
        title="RSS"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS</span>
      </a>
      <p class="text-lg">{t.home.heroText}</p>
      <p class="text-muted-foreground mt-2">
        {t.home.heroFollowBefore}{" "}
        {
          instagram && (
            <a
              href={instagram.url}
              class="text-accent underline decoration-dashed underline-offset-4"
            >
              Instagram
            </a>
          )
        }{" "}
        {t.home.heroFollowAfter}
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex items-center gap-2">
            <div class="text-muted-foreground whitespace-nowrap">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={localizedUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    if (indexLayout?.layout === "index" && indexLayout.homePath) {
      sessionStorage.setItem("backUrl", indexLayout.homePath);
    }
  });
</script>
