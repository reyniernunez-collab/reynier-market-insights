---
import type { CollectionEntry } from "astro:content";
import { getPostLocale, getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/readingTime";
import { toTransitionName } from "@/utils/toTransitionName";
import { tplStr, useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, ...props } = data;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const postLocale = getPostLocale({ id });
const isFallback = postLocale !== locale;
const minutes = getReadingTime(body);
---

<li class="my-4">
  <a
    href={getPostUrl(id, filePath, locale)}
    class:list={[
      "group block cursor-pointer rounded-xl border p-4 sm:p-5",
      "border-border/70 transition-colors duration-150",
      "hover:border-accent/60 hover:bg-surface",
      "focus-visible:border-accent/60 focus-visible:bg-surface",
    ]}
  >
    <Heading
      transition:name={toTransitionName(id)}
      lang={isFallback ? postLocale : undefined}
      class:list={[
        "text-accent text-lg font-medium",
        "decoration-dashed underline-offset-4",
        "group-hover:underline group-focus-visible:underline",
      ]}
    >
      {title}
      {
        isFallback && (
          <span class="border-border text-muted-foreground ms-1 rounded border px-1 align-middle font-mono text-xs">
            {useTranslations(postLocale).meta.shortName}
          </span>
        )
      }
    </Heading>
    <Datetime {...props} class="mt-1">
      <span class="text-muted-foreground text-sm" aria-hidden="true">·</span>
      <span class="text-muted-foreground text-sm">
        {tplStr(t.post.readingTime, { minutes })}
      </span>
    </Datetime>
    <p class="text-foreground mt-1" lang={isFallback ? postLocale : undefined}>
      {description}
    </p>
    <span
      class="text-accent mt-3 inline-flex items-center gap-1 text-sm font-semibold"
    >
      {t.post.readMore}
      <span
        aria-hidden="true"
        class="transition-transform duration-150 group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none"
        >→</span
      >
    </span>
  </a>
</li>
