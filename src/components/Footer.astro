---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import NewsletterSignup from "./NewsletterSignup.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <NewsletterSignup />
  <div class="border-border border-t py-6 sm:py-5">
    <p
      class="text-muted-foreground mb-4 text-xs leading-relaxed sm:text-sm"
      data-pagefind-ignore
    >
      <span aria-hidden="true">⚠️ </span>{t.footer.disclaimer}
    </p>
    <div
      class="flex flex-col items-center justify-between gap-2 sm:flex-row-reverse"
    >
      <Socials />
      <div
        class="text-muted-foreground flex flex-col items-center text-sm whitespace-nowrap sm:flex-row"
      >
        <span
          >{t.footer.copyright} &#169; {currentYear} {config.site.author}</span
        >
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
    </div>
  </div>
</footer>
